{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":maintainLockFilesWeekly"
  ],
  "assignees": ["modem7"],
  "labels": ["dependencies"],
  "timezone": "Europe/London",
  "packageRules": [
    {
      "description": "v-prefix workaround for GitHub Action tag versions",
      "matchDepTypes": ["action"],
      "extractVersion": "^(?<version>v\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
    },
    {
      "description": "Automerge low-risk CI plumbing updates (GitHub Actions, Woodpecker steps)",
      "matchManagers": ["github-actions", "woodpecker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update version: variables in GitHub Actions / Woodpecker pipeline files",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.woodpecker(?:/.*)?\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\s+version: (?<currentValue>.+?) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: packageName=(?<packageName>.+?))?(?: versioning=(?<versioning>.+?))?\\s"
      ]
    },
    {
      "customType": "regex",
      "description": "Update _VERSION: variables in GitHub Actions / Woodpecker pipeline files",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.woodpecker(?:/.*)?\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\s*[A-Z_]+?_VERSION: (?<currentValue>.+?) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: packageName=(?<packageName>.+?))?(?: versioning=(?<versioning>.+?))?\\s"
      ]
    }
  ]
}
